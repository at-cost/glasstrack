# ─── Required ──────────────────────────────────────────────────────────────
# Public URL people use to reach the app (https in production; cookies become Secure).
APP_URL=http://localhost:3000
# 32+ random characters. Signs file links and OAuth state. `scripts/init-env.sh` fills these.
APP_SECRET=
# Password for the bundled Postgres container.
POSTGRES_PASSWORD=
# Passwords for the two runtime roles the app creates on boot (glasstrack_app, glasstrack_system).
DB_APP_PASSWORD=
DB_SYSTEM_PASSWORD=

# ─── Database ──────────────────────────────────────────────────────────────
# Leave unset to use the bundled container. For RDS or any managed Postgres 15+:
# DATABASE_URL=postgres://owner:password@your-host:5432/glasstrack
# The DATABASE_URL user owns the schema and runs migrations; it needs CREATEROLE once
# to create the runtime roles. Postgres 15 or newer.
# DB_POOL_SIZE=10
# Run migrations when the container starts.
MIGRATE_ON_BOOT=true
# inline: web + jobs in one process (default). Split with "off" and "only" across two containers.
WORKER_MODE=inline
# Postgres memory. 1GB suits a 4 GB server.
# PG_SHARED_BUFFERS=256MB

# ─── Email ─────────────────────────────────────────────────────────────────
# Any SMTP server. AWS SES: smtps://SMTP_USER:SMTP_PASS@email-smtp.eu-west-2.amazonaws.com:465
# Unset = emails are written to the log (fine for trying it out, not for real use).
SMTP_URL=
EMAIL_FROM="Glasstrack <no-reply@example.com>"
# Email-to-issue (optional, see docs/EMAIL-TO-ISSUE.md)
# INBOUND_EMAIL_DOMAIN=in.example.com
# INBOUND_EMAIL_SECRET=a-long-random-string

# ─── File storage ─────────────────────────────────────────────────────────
# local: files live in the app volume (/data/files). s3: any S3-compatible service.
STORAGE_DRIVER=local
# S3_ENDPOINT=            # blank for AWS; e.g. http://minio:9000 or https://fsn1.your-objectstorage.com
# S3_REGION=eu-west-2
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false   # true for MinIO

# ─── Sign-in providers (optional) ─────────────────────────────────────────
# Callback URLs: $APP_URL/api/v1/auth/oauth/google/callback and .../github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Backups ───────────────────────────────────────────────────────────────
# Daily pg_dump to storage under backups/ (S3 recommended so backups leave the server).
BACKUP_ENABLED=false
BACKUP_CRON="15 3 * * *"

# ─── Hosted mode only ──────────────────────────────────────────────────────
# Credits, billing and metering. Self-hosters leave this off: every feature works without it.
BILLING_ENABLED=false
# Stripe (USD). Webhook endpoint: $APP_URL/api/v1/stripe/webhook with events
# checkout.session.completed, checkout.session.async_payment_succeeded, checkout.session.expired,
# payment_intent.succeeded, payment_intent.payment_failed, charge.refunded
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Prices, signup credit and top-up limits are set in the operator admin (pricing settings), not here.
# BILLING_STARTER_DOMAIN_LIMIT=3      # signup credits per company email domain per 30 days
# Public finances (hosted mode). On automatically with billing; set this to publish costs before billing is on.
# FINANCES_PUBLIC=false
# Operators enter costs, savings and pricing settings, and process refunds, in /admin.
# OPERATOR_EMAILS=you@example.com
# AWS Cost Explorer import (otherwise enter costs by hand in the operator admin). The key needs ce:GetCostAndUsage.
# AWS_COST_EXPLORER_ENABLED=false
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Self-hosted SSO providers (Keycloak, Authentik) on a private network:
# SSO_ALLOW_PRIVATE=false
# WEBHOOK_ALLOW_PRIVATE=false

# ─── Misc ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# The public /status page links here when set (otherwise it shows a live health check).
# STATUS_PAGE_URL=https://status.example.com
# HOST_PORT=3000
# DOMAIN=glasstrack.example.com   # for --profile tls (Caddy gets a certificate automatically)
