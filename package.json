{
  "name": "glasstrack",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "migrate": "pnpm --filter @glasstrack/server migrate",
    "seed": "pnpm --filter @glasstrack/server seed",
    "site:screenshots": "node scripts/site-screenshots.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
