{
  "name": "@glasstrack/server",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "tsx --env-file-if-exists=../../.env src/cli/migrate.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/cli/seed.ts"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@glasstrack/shared": "workspace:*",
    "@hono/node-server": "^2.1.5",
    "arctic": "^3.7.0",
    "aws4fetch": "^1.0.20",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "kysely": "^0.29.6",
    "nodemailer": "^10.1.1",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "pino": "^10.4.0",
    "stripe": "^23.0.0",
    "zod": "^4.6.7"
  }
}
